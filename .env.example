# Gemini key used by the PM/review automation scripts
GEMINI_KEY=your_gemini_api_key_here

# Codex batch executor configuration
CODEX_MODEL=gpt-5.4
CODEX_SANDBOX=workspace-write

# Set to true only if you want the executor to bypass sandboxing locally.
# This is powerful and risky; keep false unless you fully trust the environment.
CODEX_DANGEROUS_BYPASS=false

# Automation controls
AUTO_MAX_CYCLES=3
AUTO_CHECK_INTERVAL=10
AUTO_CHECK_DISCOVERY_ATTEMPTS=12
AUTO_MERGE_ON_APPROVAL=true
AUTO_BRANCH_PREFIX=feature
